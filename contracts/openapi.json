{
  "components": {
    "schemas": {
      "ClearDataResponse": {
        "additionalProperties": false,
        "description": "Response returned after clearing owner-scoped data.\n\nAttributes:\n    deleted_tasks: Number of task rows deleted.",
        "properties": {
          "deleted_tasks": {
            "title": "Deleted Tasks",
            "type": "integer"
          }
        },
        "required": [
          "deleted_tasks"
        ],
        "title": "ClearDataResponse",
        "type": "object"
      },
      "ExtractionState": {
        "description": "Extension collection states for page text extraction.",
        "enum": [
          "ready",
          "inaccessible",
          "unloaded",
          "error"
        ],
        "title": "ExtractionState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Health check response.\n\nAttributes:\n    status: Service health marker.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstallationResponse": {
        "additionalProperties": false,
        "description": "Response returned when issuing an anonymous installation credential.\n\nAttributes:\n    owner_id: Owner identifier created for this installation.\n    installation_credential: Bearer credential shown once to the extension.\n    token_type: Credential type used in the Authorization header.",
        "properties": {
          "installation_credential": {
            "title": "Installation Credential",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "owner_id",
          "installation_credential"
        ],
        "title": "InstallationResponse",
        "type": "object"
      },
      "ManualTaskCreateRequest": {
        "additionalProperties": false,
        "description": "Request to create a manual task with an owner-scoped idempotency key.\n\nAttributes:\n    client_request_id: Client-generated idempotency key.\n    title: User-visible manual task title.",
        "example": {
          "client_request_id": "sidebar-manual-001",
          "title": "Review Yokohama tabs before standup"
        },
        "properties": {
          "client_request_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "client_request_id",
          "title"
        ],
        "title": "ManualTaskCreateRequest",
        "type": "object"
      },
      "ManualTaskPatchRequest": {
        "additionalProperties": false,
        "description": "Request to patch mutable fields on a manual task.\n\nAttributes:\n    title: Optional replacement title.\n    status: Optional replacement task status.\n    status_reason: Optional replacement or explicit null status reason.",
        "example": {
          "status": "action_complete",
          "status_reason": "Marked complete by the user.",
          "title": "Review Yokohama tabs after lunch"
        },
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "status_reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "ManualTaskPatchRequest",
        "type": "object"
      },
      "ObservationInput": {
        "additionalProperties": false,
        "description": "Observation submitted by the extension for scan ingestion.\n\nAttributes:\n    client_observation_id: Extension-generated idempotency identifier.\n    source_url: Captured page URL.\n    title: Captured page title.\n    observed_at: Timestamp when the extension observed the page.\n    text: Bounded rendered page text.\n    extraction_state: Collection outcome from the extension.\n    truncated: Whether text was truncated before submission.\n    screenshot_id: Optional backend image identifier for screenshot fallback.",
        "properties": {
          "client_observation_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Observation Id",
            "type": "string"
          },
          "extraction_state": {
            "$ref": "#/components/schemas/ExtractionState"
          },
          "observed_at": {
            "format": "date-time",
            "title": "Observed At",
            "type": "string"
          },
          "screenshot_id": {
            "anyOf": [
              {
                "maxLength": 36,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Screenshot Id"
          },
          "source_url": {
            "format": "uri",
            "minLength": 1,
            "title": "Source Url",
            "type": "string"
          },
          "text": {
            "maxLength": 12000,
            "title": "Text",
            "type": "string"
          },
          "title": {
            "maxLength": 512,
            "title": "Title",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "client_observation_id",
          "source_url",
          "title",
          "observed_at",
          "text",
          "extraction_state",
          "truncated"
        ],
        "title": "ObservationInput",
        "type": "object"
      },
      "ProcessingState": {
        "description": "Background processing state values.",
        "enum": [
          "queued",
          "running",
          "ready",
          "failed"
        ],
        "title": "ProcessingState",
        "type": "string"
      },
      "ScanCounts": {
        "additionalProperties": false,
        "description": "Aggregated item counts for a submitted scan.\n\nAttributes:\n    total: Number of scan items in the scan.\n    accepted: Items accepted for detection or already ready.\n    unchanged: Items matching the latest accepted source content.\n    superseded: Items older than the latest accepted source observation.\n    failed: Items that failed before terminal processing.",
        "properties": {
          "accepted": {
            "title": "Accepted",
            "type": "integer"
          },
          "failed": {
            "title": "Failed",
            "type": "integer"
          },
          "superseded": {
            "title": "Superseded",
            "type": "integer"
          },
          "total": {
            "title": "Total",
            "type": "integer"
          },
          "unchanged": {
            "title": "Unchanged",
            "type": "integer"
          }
        },
        "required": [
          "total",
          "accepted",
          "unchanged",
          "superseded",
          "failed"
        ],
        "title": "ScanCounts",
        "type": "object"
      },
      "ScanCreateRequest": {
        "additionalProperties": false,
        "description": "Request body used to submit a batch scan.\n\nAttributes:\n    client_request_id: Extension-generated idempotency identifier.\n    observations: Observations included in the scan.",
        "properties": {
          "client_request_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/ObservationInput"
            },
            "maxItems": 20,
            "minItems": 1,
            "title": "Observations",
            "type": "array"
          }
        },
        "required": [
          "client_request_id",
          "observations"
        ],
        "title": "ScanCreateRequest",
        "type": "object"
      },
      "ScanCreateResponse": {
        "additionalProperties": false,
        "description": "Response returned after accepting a scan.\n\nAttributes:\n    scan_id: Backend scan identifier.\n    state: Initial processing state.",
        "properties": {
          "scan_id": {
            "format": "uuid",
            "title": "Scan Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ScanState"
          }
        },
        "required": [
          "scan_id",
          "state"
        ],
        "title": "ScanCreateResponse",
        "type": "object"
      },
      "ScanItemResponse": {
        "additionalProperties": false,
        "description": "Per-observation scan item returned while polling.\n\nAttributes:\n    observation_id: Observation associated with the item.\n    task_id: Task produced by detection, when available.\n    source_key: Owner-scoped normalized URL key.\n    processing_state: Item processing state.\n    detection_outcome: Detection outcome discriminator, when available.\n    error_code: Stable item-level error code, when available.",
        "properties": {
          "detection_outcome": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detection Outcome"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "observation_id": {
            "format": "uuid",
            "title": "Observation Id",
            "type": "string"
          },
          "processing_state": {
            "$ref": "#/components/schemas/ScanItemState"
          },
          "source_key": {
            "title": "Source Key",
            "type": "string"
          },
          "task_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Id"
          }
        },
        "required": [
          "observation_id",
          "task_id",
          "source_key",
          "processing_state",
          "detection_outcome",
          "error_code"
        ],
        "title": "ScanItemResponse",
        "type": "object"
      },
      "ScanItemState": {
        "description": "Allowed per-observation scan item states.",
        "enum": [
          "queued",
          "running",
          "ready",
          "failed",
          "unchanged",
          "superseded"
        ],
        "title": "ScanItemState",
        "type": "string"
      },
      "ScanResponse": {
        "additionalProperties": false,
        "description": "Poll response for a submitted scan.\n\nAttributes:\n    scan_id: Backend scan identifier.\n    client_request_id: Extension-generated idempotency identifier.\n    state: Scan processing state.\n    counts: Aggregated item counts.\n    items: Per-observation item state.\n    error_code: Optional scan-level error code.\n    created_at: Timestamp when the scan was created.\n    updated_at: Timestamp when the scan last changed.",
        "properties": {
          "client_request_id": {
            "title": "Client Request Id",
            "type": "string"
          },
          "counts": {
            "$ref": "#/components/schemas/ScanCounts"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScanItemResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "scan_id": {
            "format": "uuid",
            "title": "Scan Id",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/ScanState"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "scan_id",
          "client_request_id",
          "state",
          "counts",
          "items",
          "error_code",
          "created_at",
          "updated_at"
        ],
        "title": "ScanResponse",
        "type": "object"
      },
      "ScanState": {
        "description": "Allowed scan processing states.",
        "enum": [
          "queued",
          "running",
          "ready",
          "failed"
        ],
        "title": "ScanState",
        "type": "string"
      },
      "TaskCard": {
        "additionalProperties": false,
        "description": "Task card returned to the extension sidebar.\n\nAttributes:\n    id: Stable task identifier.\n    origin: Whether the task is detected or manual.\n    source_key: Nullable source key for detected tasks.\n    source_url: Nullable source URL used for return-to-tab behavior.\n    type: Supported task type.\n    title: User-visible task title.\n    status: User-visible task status.\n    status_reason: Optional status explanation.\n    summary: Optional grounded summary.\n    processing_state: Background processing state.\n    processing_error_code: Optional processing error code.\n    observed_at: Latest source observation time.\n    updated_at: Timestamp when the task last changed.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "origin": {
            "$ref": "#/components/schemas/TaskOrigin"
          },
          "processing_error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Error Code"
          },
          "processing_state": {
            "$ref": "#/components/schemas/ProcessingState"
          },
          "source_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Key"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TaskType"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "origin",
          "source_key",
          "source_url",
          "type",
          "title",
          "status",
          "status_reason",
          "summary",
          "processing_state",
          "processing_error_code",
          "observed_at",
          "updated_at"
        ],
        "title": "TaskCard",
        "type": "object"
      },
      "TaskListResponse": {
        "additionalProperties": false,
        "description": "Response containing owner-scoped task cards.\n\nAttributes:\n    tasks: Task cards visible to the authenticated owner.",
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskCard"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "tasks"
        ],
        "title": "TaskListResponse",
        "type": "object"
      },
      "TaskOrigin": {
        "description": "Allowed task origin values.",
        "enum": [
          "detected",
          "manual"
        ],
        "title": "TaskOrigin",
        "type": "string"
      },
      "TaskStatus": {
        "description": "User-visible task status values.",
        "enum": [
          "in_progress",
          "needs_attention",
          "action_complete",
          "error"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskType": {
        "description": "Supported high-level task categories.",
        "enum": [
          "github",
          "research",
          "email",
          "travel",
          "shopping",
          "manual"
        ],
        "title": "TaskType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Browser Task Sidebar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Return a simple service health response.\n\nReturns:\n    A successful health response.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/data": {
      "delete": {
        "description": "Delete retained task, scan, source, observation, and image data.\n\nArgs:\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to delete owner-scoped records.\n\nReturns:\n    Counts for deleted owner-scoped task records.",
        "operationId": "clear_data_v1_data_delete",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearDataResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clear Data",
        "tags": [
          "tasks"
        ]
      }
    },
    "/v1/installations": {
      "post": {
        "description": "Issue an anonymous installation credential.\n\nArgs:\n    session: Database session used to persist the owner.\n\nReturns:\n    The owner identifier and one-time bearer credential for the extension.",
        "operationId": "create_installation_v1_installations_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Installation",
        "tags": [
          "installations"
        ]
      }
    },
    "/v1/scans": {
      "post": {
        "description": "Accept an idempotent batch of page observations.\n\nArgs:\n    request: Scan request from the extension service worker.\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to persist scan state.\n\nReturns:\n    Accepted scan identifier and aggregate state.\n\nRaises:\n    HTTPException: Raised when an observation or screenshot reference is invalid.",
        "operationId": "create_scan_v1_scans_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanCreateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Scan",
        "tags": [
          "scans"
        ]
      }
    },
    "/v1/scans/{scan_id}": {
      "get": {
        "description": "Return scan status and item outcomes for the authenticated owner.\n\nArgs:\n    scan_id: Scan identifier from the URL.\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to load scan state.\n\nReturns:\n    Owner-scoped scan status and per-item outcomes.\n\nRaises:\n    HTTPException: Raised when the scan is absent for this owner.",
        "operationId": "get_scan_v1_scans__scan_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "scan_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Scan Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Scan",
        "tags": [
          "scans"
        ]
      }
    },
    "/v1/tasks": {
      "get": {
        "description": "Return task cards visible to the authenticated owner.\n\nArgs:\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to load tasks.\n\nReturns:\n    Owner-scoped task cards ordered by most recently updated first.",
        "operationId": "list_tasks_v1_tasks_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Tasks",
