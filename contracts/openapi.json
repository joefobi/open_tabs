    "/v1/tasks/{task_id}": {
      "delete": {
        "description": "Delete one task owned by the authenticated owner.\n\nArgs:\n    task_id: The task identifier from the URL.\n    owner: The authenticated owner boundary.\n    repository: The repository that stores task data.\n\nReturns:\n    An empty 204 response when the task is deleted.\n\nRaises:\n    HTTPException: Raised with 404 when the task is absent for this owner.",
        "operationId": "delete_task_v1_tasks__task_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "title": "Task Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
