{
  "components": {
    "schemas": {
      "ClearDataResponse": {
        "additionalProperties": false,
        "description": "Response returned after clearing owner-scoped data.\n\nAttributes:\n    deleted_tasks: Number of task rows deleted.",
        "properties": {
          "deleted_tasks": {
            "title": "Deleted Tasks",
            "type": "integer"
          }
        },
        "required": [
          "deleted_tasks"
        ],
        "title": "ClearDataResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Health check response.\n\nAttributes:\n    status: Service health marker.",
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InstallationResponse": {
        "additionalProperties": false,
        "description": "Response returned when issuing an anonymous installation credential.\n\nAttributes:\n    owner_id: Owner identifier created for this installation.\n    installation_credential: Bearer credential shown once to the extension.\n    token_type: Credential type used in the Authorization header.",
        "properties": {
          "installation_credential": {
            "title": "Installation Credential",
            "type": "string"
          },
          "owner_id": {
            "format": "uuid",
            "title": "Owner Id",
            "type": "string"
          },
          "token_type": {
            "const": "bearer",
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "owner_id",
          "installation_credential"
        ],
        "title": "InstallationResponse",
        "type": "object"
      },
      "ManualTaskCreateRequest": {
        "additionalProperties": false,
        "description": "Request to create a manual task with an owner-scoped idempotency key.\n\nAttributes:\n    client_request_id: Client-generated idempotency key.\n    title: User-visible manual task title.",
        "example": {
          "client_request_id": "sidebar-manual-001",
          "title": "Review Yokohama tabs before standup"
        },
        "properties": {
          "client_request_id": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Client Request Id",
            "type": "string"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "client_request_id",
          "title"
        ],
        "title": "ManualTaskCreateRequest",
        "type": "object"
      },
      "ManualTaskPatchRequest": {
        "additionalProperties": false,
        "description": "Request to patch mutable fields on a manual task.\n\nAttributes:\n    title: Optional replacement title.\n    status: Optional replacement task status.\n    status_reason: Optional replacement or explicit null status reason.",
        "example": {
          "status": "action_complete",
          "status_reason": "Marked complete by the user.",
          "title": "Review Yokohama tabs after lunch"
        },
        "properties": {
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "status_reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "title": "ManualTaskPatchRequest",
        "type": "object"
      },
      "ProcessingState": {
        "description": "Background processing state values.",
        "enum": [
          "queued",
          "running",
          "ready",
          "failed"
        ],
        "title": "ProcessingState",
        "type": "string"
      },
      "TaskCard": {
        "additionalProperties": false,
        "description": "Task card returned to the extension sidebar.\n\nAttributes:\n    id: Stable task identifier.\n    origin: Whether the task is detected or manual.\n    source_key: Nullable source key for detected tasks.\n    source_url: Nullable source URL used for return-to-tab behavior.\n    type: Supported task type.\n    title: User-visible task title.\n    status: User-visible task status.\n    status_reason: Optional status explanation.\n    summary: Optional grounded summary.\n    processing_state: Background processing state.\n    processing_error_code: Optional processing error code.\n    observed_at: Latest source observation time.\n    updated_at: Timestamp when the task last changed.",
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "observed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "origin": {
            "$ref": "#/components/schemas/TaskOrigin"
          },
          "processing_error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processing Error Code"
          },
          "processing_state": {
            "$ref": "#/components/schemas/ProcessingState"
          },
          "source_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Key"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
          "summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Summary"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/TaskType"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "origin",
          "source_key",
          "source_url",
          "type",
          "title",
          "status",
          "status_reason",
          "summary",
          "processing_state",
          "processing_error_code",
          "observed_at",
          "updated_at"
        ],
        "title": "TaskCard",
        "type": "object"
      },
      "TaskListResponse": {
        "additionalProperties": false,
        "description": "Response containing owner-scoped task cards.\n\nAttributes:\n    tasks: Task cards visible to the authenticated owner.",
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskCard"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "tasks"
        ],
        "title": "TaskListResponse",
        "type": "object"
      },
      "TaskOrigin": {
        "description": "Allowed task origin values.",
        "enum": [
          "detected",
          "manual"
        ],
        "title": "TaskOrigin",
        "type": "string"
      },
      "TaskStatus": {
        "description": "User-visible task status values.",
        "enum": [
          "in_progress",
          "needs_attention",
          "action_complete",
          "error"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskType": {
        "description": "Supported high-level task categories.",
        "enum": [
          "github",
          "research",
          "email",
          "travel",
          "shopping",
          "manual"
        ],
        "title": "TaskType",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Browser Task Sidebar API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Return a simple service health response.\n\nReturns:\n    A successful health response.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Healthz",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/data": {
      "delete": {
        "description": "Delete retained task, scan, source, observation, and image data.\n\nArgs:\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to delete owner-scoped records.\n\nReturns:\n    Counts for deleted owner-scoped task records.",
        "operationId": "clear_data_v1_data_delete",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClearDataResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Clear Data",
        "tags": [
          "tasks"
        ]
      }
    },
    "/v1/installations": {
      "post": {
        "description": "Issue an anonymous installation credential.\n\nArgs:\n    session: Database session used to persist the owner.\n\nReturns:\n    The owner identifier and one-time bearer credential for the extension.",
        "operationId": "create_installation_v1_installations_post",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallationResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Create Installation",
        "tags": [
          "installations"
        ]
      }
    },
    "/v1/tasks": {
      "get": {
        "description": "Return task cards visible to the authenticated owner.\n\nArgs:\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to load tasks.\n\nReturns:\n    Owner-scoped task cards ordered by most recently updated first.",
        "operationId": "list_tasks_v1_tasks_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Tasks",
        "tags": [
          "tasks"
        ]
      },
      "post": {
        "description": "Create an idempotent manual task for the authenticated owner.\n\nArgs:\n    request: Manual task payload with client idempotency key.\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to create or load the task.\n\nReturns:\n    Created or replayed manual task card.",
        "operationId": "create_manual_task_v1_tasks_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualTaskCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Manual Task",
        "tags": [
          "tasks"
        ]
      }
    },
    "/v1/tasks/{task_id}": {
      "delete": {
        "description": "Delete one task owned by the authenticated owner.\n\nArgs:\n    task_id: Task identifier from the URL.\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to delete the task.\n\nReturns:\n    Empty 204 response when deletion succeeds.\n\nRaises:\n    HTTPException: Raised with 404 when the task is absent for this owner.",
        "operationId": "delete_task_v1_tasks__task_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Task",
        "tags": [
          "tasks"
        ]
      },
      "patch": {
        "description": "Patch a manual task owned by the authenticated owner.\n\nArgs:\n    task_id: Task identifier from the URL.\n    request: Mutable manual task fields to update.\n    owner: Authenticated owner resolved from bearer credentials.\n    session: Database session used to update the task.\n\nReturns:\n    Updated manual task card.\n\nRaises:\n    HTTPException: Raised with 400 for empty patches or 404 for absent tasks.",
        "operationId": "update_manual_task_v1_tasks__task_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Task Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualTaskPatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskCard"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Manual Task",
        "tags": [
          "tasks"
        ]
      }
    }
  }
}
