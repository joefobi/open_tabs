        "tags": [
          "tasks"
        ]
      },
      "patch": {
        "description": "Patch a manual task owned by the authenticated owner.\n\nArgs:\n    task_id: The task identifier from the URL.\n    request: The mutable manual task fields to update.\n    owner: The authenticated owner boundary.\n    repository: The repository that stores task data.\n\nReturns:\n    The updated task.\n\nRaises:\n    HTTPException: Raised with 400 for empty patches or 404 for absent tasks.",
        "operationId": "update_manual_task_v1_tasks__task_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
